# ===== GitHub Models settings =====
# GitHub の Personal Access Token（`models:read` 権限が必要）を設定してください。
# https://docs.github.com/en/github-models/use-github-models/prototyping-with-ai-models
GITHUB_TOKEN=your_github_personal_access_token_here

# GitHub Models の OpenAI 互換エンドポイント
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference

# 使用するモデル（GitHub Models のモデル名）
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# ===== Server settings =====
PORT=3000
